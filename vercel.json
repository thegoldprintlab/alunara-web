{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/lead.js": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/guestbook-sign.js": {
      "memory": 256,
      "maxDuration": 20
    },
    "api/guestbook-zip.js": {
      "memory": 512,
      "maxDuration": 60
    }
  }
}