# Skrip migration/debug one-off (ada credential DB hardcoded) — jangan commit.
# Guna `scripts/*` (bukan `scripts/`) supaya pengecualian di bawah berkesan —
# git TIDAK boleh re-include fail kalau direktori induknya di-ignore penuh.
scripts/*
# kecuali skrip deploy/uji yang sah (tiada credential)
!scripts/patch-vercel-config.mjs
!scripts/prerender.mjs
!scripts/uji-qr-poster.mjs
# penjana font poster — perlu dijejak supaya font boleh dibina semula dari sumber
!scripts/bina-font-poster.py
!scripts/apply-fn-ucapan.mjs
!scripts/fix-voice-mime.mjs
